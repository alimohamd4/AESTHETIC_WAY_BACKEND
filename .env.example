# ============================================================
# AESTHETIC WAY Backend - Environment Variables
# Copy to .env and fill in real values
# ============================================================

# --- Django ---
SECRET_KEY=your-secret-key-here-change-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,api.aestheticway.ae
DJANGO_SETTINGS_MODULE=config.settings.development

# --- Database ---
DB_NAME=aesthetic_way
DB_USER=aesthetic_way
DB_PASSWORD=your-db-password-here
DB_HOST=localhost
DB_PORT=5432
DB_CONN_MAX_AGE=60

# --- Redis ---
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# --- CORS ---
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000

# --- Storage (set USE_S3=True for production) ---
USE_S3=False
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=aw-clinic-images
AWS_S3_REGION_NAME=us-east-1
AWS_S3_CUSTOM_DOMAIN=cdn.aestheticway.ae

# --- OTP ---
OTP_SECRET_KEY=your-otp-hmac-secret-here

# --- SMS ---
SMS_PROVIDER=unifonic
UNIFONIC_APP_SID=
UNIFONIC_SENDER_ID=AestheticWay

# --- Push Notifications ---
FCM_SERVER_KEY=

# --- Email ---
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.sendgrid.net
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=apikey
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@aestheticway.ae
